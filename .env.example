# App Config
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Agentic Supply Chain Orchestrator"
API_V1_STR="/api/v1"

# Database & Cache
DATABASE_URL=postgresql://user:password@localhost:5432/supply_chain
REDIS_URL=redis://localhost:6379/0

# Security Secrets
SECRET_KEY=change_this_to_a_secure_256_bit_random_secret_key_in_production
ENCRYPTION_KEY=change_this_to_fernet_32_byte_base64_key

# AI Agent (Anthropic Claude API for Agent Brain)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# External Integrations (Optional / Mock for MVP)
MAPBOX_TOKEN=your_mapbox_token_here
OPENWEATHER_API_KEY=your_openweather_key_here
